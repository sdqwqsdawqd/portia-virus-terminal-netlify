NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY name is still accepted as a fallback.
PORTIA_PROMOTION_DEVICE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
PORTIA_E2E_PRODUCTION_PROJECT_IDS=COMMA_SEPARATED_20_CHARACTER_PROJECT_REFS
# For `npm run test:e2e:mutation`, export these in the shell together with the production list above.
# Playwright does not load env files and the mutation preflight ignores values set only in a file.
# PORTIA_E2E_ISOLATED_PROJECT_IDS=COMMA_SEPARATED_20_CHARACTER_PROJECT_REFS
# PORTIA_E2E_TARGET_ID=ONE_20_CHARACTER_ISOLATED_PROJECT_REF
# PORTIA_E2E_SUPABASE_URL=https://YOUR_ISOLATED_PROJECT_REF.supabase.co
# PORTIA_E2E_TARGET_ENVIRONMENT=isolated-test
# PORTIA_E2E_MUTATION_CONFIRM=ISOLATED_TEST_PROJECT
# Phase 16 staging wrapper (scripts/phase16-staging.mjs) and the live promotion suite: set these ONLY in the shell,
# for the isolated project only. Never put values in a file and never use production values.
# PORTIA_PROMO_LIVE_URL=https://YOUR_ISOLATED_PROJECT_REF.supabase.co
# PORTIA_PROMO_LIVE_ANON_KEY=ISOLATED_PROJECT_PUBLISHABLE_KEY
# PORTIA_PROMO_LIVE_SERVICE_ROLE_KEY=ISOLATED_PROJECT_ADMIN_KEY
# PORTIA_PROMO_LIVE_CONFIRM=ISOLATED_TEST_PROJECT
# PORTIA_STAGING_DB_URL=postgresql://postgres.<ISOLATED_REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
